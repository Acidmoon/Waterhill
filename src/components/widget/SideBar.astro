---
import type { MarkdownHeading } from "astro";
import CategoryPosts from "./CategoryPosts.astro";
import Profile from "./Profile.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	category?: string | null;
	currentSlug?: string;
}

const className = Astro.props.class;
const { category, currentSlug } = Astro.props;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    {category && <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        <CategoryPosts class="onload-animation" style="animation-delay: 150ms" category={category} currentSlug={currentSlug}></CategoryPosts>
    </div>}
</div>
