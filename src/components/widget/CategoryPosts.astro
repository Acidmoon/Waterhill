---
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getSortedPostsList } from "../../utils/content-utils";
import { getPostUrlBySlug } from "../../utils/url-utils";
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	category?: string | null;
	currentSlug?: string;
}
const { category, currentSlug } = Astro.props;
const className = Astro.props.class;
const style = Astro.props.style;

const COLLAPSED_HEIGHT = "7.5rem";
const COLLAPSE_THRESHOLD = 5;

const categoryKey = typeof category === "string" ? category.trim() : "";

const posts =
	categoryKey === "" || !currentSlug
		? []
		: (await getSortedPostsList()).filter((post) => {
				const key =
					typeof post.data.category === "string"
						? post.data.category.trim()
						: "";
				return key === categoryKey && post.slug !== currentSlug;
			});

const isCollapsed = posts.length >= COLLAPSE_THRESHOLD;
---

{posts.length > 0 && (
	<WidgetLayout
		name={i18n(I18nKey.categoryPosts)}
		id="category-posts"
		isCollapsed={isCollapsed}
		collapsedHeight={COLLAPSED_HEIGHT}
		class={className}
		style={style}
	>
		{posts.map((post) => (
			<ButtonLink
				url={getPostUrlBySlug(post.slug)}
				label={`Read the post ${post.data.title.trim()}`}
			>
				{post.data.title.trim()}
			</ButtonLink>
		))}
	</WidgetLayout>
)}
