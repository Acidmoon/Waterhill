---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import Categories from "./widget/Categories.astro";
import Tags from "./widget/Tags.astro";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

const archiveUrl = LinkPresets[LinkPreset.Archive].url;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2" />
                {siteConfig.title}
            </div>
        </a>
        <div class="hidden md:flex">
            {links.map((l) => {
                return (
                    <>
                        {/* 分类/标签弹窗入口固定插在归档链接之前（需求位置：主页与归档之间） */}
                        {l.url === archiveUrl && (
                            <div class="relative">
                                <button aria-label={i18n(I18nKey.categories)} aria-haspopup="true" aria-expanded="false"
                                        class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95"
                                        data-panel-toggle="nav-panel-categories"
                                >
                                    {i18n(I18nKey.categories)}
                                </button>
                                <div id="nav-panel-categories" class="nav-float-panel absolute top-full left-1/2 -translate-x-1/2 pt-4 transition-all float-panel-closed">
                                    <div class="card-base float-panel w-80 max-w-[calc(100vw-2rem)]">
                                        <Categories></Categories>
                                    </div>
                                </div>
                            </div>
                        )}
                        {l.url === "/archive/" && (
                            <div class="relative">
                                <button aria-label={i18n(I18nKey.tags)} aria-haspopup="true" aria-expanded="false"
                                        class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95"
                                        data-panel-toggle="nav-panel-tags"
                                >
                                    {i18n(I18nKey.tags)}
                                </button>
                                <div id="nav-panel-tags" class="nav-float-panel absolute top-full left-1/2 -translate-x-1/2 pt-4 transition-all float-panel-closed">
                                    <div class="card-base float-panel w-80 max-w-[calc(100vw-2rem)]">
                                        <Tags></Tags>
                                    </div>
                                </div>
                            </div>
                        )}
                        <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95"
                        >
                            <div class="flex items-center">
                                {l.name}
                                {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                            </div>
                        </a>
                    </>
                );
            })}
        </div>
        <div class="flex">
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch client:only="svelte"></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:only="svelte"></DisplaySettings>
    </div>
</div>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function closeAllNavPanels() {
    document.querySelectorAll(".nav-float-panel").forEach(function (panel) {
        panel.classList.add("float-panel-closed");
    });
    document.querySelectorAll("[data-panel-toggle]").forEach(function (btn) {
        btn.setAttribute("aria-expanded", "false");
    });
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    document.querySelectorAll<HTMLElement>("[data-panel-toggle]").forEach(function (btn) {
        btn.onclick = function () {
            let panel = document.getElementById(btn.getAttribute("data-panel-toggle") ?? "");
            if (!panel) {
                return;
            }
            let wasClosed = panel.classList.contains("float-panel-closed");
            closeAllNavPanels();
            if (wasClosed) {
                panel.classList.remove("float-panel-closed");
                btn.setAttribute("aria-expanded", "true");
            }
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.add("float-panel-closed");
            }
        };
    });

    // swup 会重复执行本脚本，文档级监听只能绑定一次
    if (!window.__navPanelOutsideClickListener) {
        window.__navPanelOutsideClickListener = true;
        document.addEventListener("click", function (e) {
            if (!(e.target instanceof Element)) {
                return;
            }
            if (e.target.closest(".nav-float-panel a")) {
                closeAllNavPanels();
                return;
            }
            if (e.target.closest("[data-panel-toggle]") || e.target.closest(".nav-float-panel")) {
                return;
            }
            closeAllNavPanels();
        });
    }

    document.querySelectorAll<HTMLElement>("[data-submenu-toggle]").forEach(function (btn) {
        btn.onclick = function () {
            let submenu = document.getElementById(btn.getAttribute("data-submenu-toggle") ?? "");
            if (!submenu) {
                return;
            }
            submenu.classList.toggle("hidden");
            btn.setAttribute("aria-expanded", submenu.classList.contains("hidden") ? "false" : "true");
            btn.querySelectorAll("svg").forEach(function (icon) {
                icon.classList.toggle("rotate-90");
            });
        };
    });
}

loadButtonScript();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
